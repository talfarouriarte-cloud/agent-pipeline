+      - name: Materializar transición CROSS-ISSUE declarada por el resolver (resolve-cross-issue-failsafe)
+        # AP-064 (repesca finplan#1694, aud. finplan#1711) — el belt que compara
+        # lo que el resolver DECLARÓ en prosa sobre un issue AJENO contra el
+        # ESTADO de ese issue, y ejecuta solo la diferencia. El cuerpo NO vive
+        # aquí sino en `vendored/scripts/resolve-cross-issue-failsafe.cjs`,
+        # servido al workspace por `graft-vendored` (AP-068): la App no tiene
+        # permiso `workflows` (ADR-020, tres medidas), luego el código embebido
+        # en este fichero era intocable para un agente. El porqué completo, los
+        # guards y los cinco frentes de fail-open están documentados en el
+        # módulo; aquí solo queda la invocación.
+        if: always()
+        uses: actions/github-script@v7
+        env:
+          # Kill-switch reutilizado, sin label fija nueva: el conjunto de
+          # exclusión es el MISMO que el del detector (`pause-agents`,
+          # `human-needed`, paneles). Un ítem que el watchdog no vigila tampoco
+          # se toca por este belt.
+          IN_SKIP_LABELS: ${{ inputs.skip_labels }}
+        with:
+          github-token: ${{ secrets.REVIEWER_GITHUB_TOKEN }}
+          script: |
+            const ruta = `${process.env.GITHUB_WORKSPACE}/scripts/resolve-cross-issue-failsafe.cjs`;
+            let belt;
+            // Fail-open ANUNCIADO: si el graft no corrió (o sirvió una versión
+            // sin el módulo), el belt queda MUDO — pero que lo esté tiene que
+            // verse, que es la clase entera que AP-064 cierra.
+            try { belt = require(ruta); }
+            catch (e) { core.warning(`resolve-cross-issue: módulo no injertado en ${ruta} (${e.message}) — belt MUDO en esta corrida.`); return; }
+            await belt({ github, context, core, skipLabels: process.env.IN_SKIP_LABELS });
+
