           ARM_TOKEN: ${{ secrets.REVIEWER_GITHUB_TOKEN }}
+          # AP-081 — la autorización de subagentes por el canal de SYSTEM PROMPT.
+          # `src/entrypoints/run.ts` de claude-code-action lee esta variable de
+          # entorno (NO es un input de la action) y la pasa como
+          # `appendSystemPrompt` a la SDK. Es el canal que va MÁS CERCA de donde
+          # vive la prohibición: el literal «Do not call the AgentTool unless the
+          # user requested it» está COMPILADO en el binario del harness
+          # (`@anthropic-ai/claude-agent-sdk`) — no lo emite esta action (medido
+          # por grep sobre `src/create-prompt/index.ts` y sobre el binario), luego
